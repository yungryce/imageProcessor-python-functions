  "components": {
    "image_processor": {
      "type": "service",
      "path": "function_app.py",
      "description": "Main Azure Function handling image upload, compression, and storage operations",
      "dependencies": ["azure-functions", "azure-storage-blob", "Pillow"],
      "interfaces": ["upload_image", "get_image", "list_images", "compress_image"]
    },
    "compression_engine": {
      "type": "utility",
      "path": "function_app.py#compress_image",
      "description": "Intelligent image compression algorithm with quality optimization",
      "dependencies": ["Pillow", "BytesIO"],
      "interfaces": ["quality_adjustment", "format_preservation", "size_optimization"]
    },
    "storage_manager": {
      "type": "service",
      "path": "function_app.py#ensure_container_exists",
      "description": "Azure Blob Storage container and file management service",
      "dependencies": ["azure-storage-blob"],
      "interfaces": ["container_creation", "blob_upload", "blob_retrieval"]
    },
    "api_endpoints": {
      "type": "interface",
      "path": "function_app.py",
      "description": "RESTful API endpoints for image operations",
      "dependencies": ["azure-functions"],
      "interfaces": ["http_upload", "http_retrieval", "http_listing"]
    }
  },
